# Base URL of the Board Portal API.
# Local dev: leave blank — vite proxies /api to VITE_API_TARGET below.
VITE_API_URL=

# Where the vite dev-server proxy forwards /api during `npm run dev`
VITE_API_TARGET=http://localhost:3013

# Default skin: "masonsview" (host-product look) or "classic" (original design)
VITE_DEFAULT_SKIN=masonsview
