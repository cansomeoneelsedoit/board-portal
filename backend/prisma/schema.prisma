// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  role        String   @default("DIRECTOR")
  initials    String?
  createdAt   DateTime @default(now())
  
  invitations   Invitation[]
  attendances   Attendance[]
  votesAs       Vote[]
  cois          COI[]
  proxiesFrom   Proxy[]  @relation("ProxyFrom")
  proxiesTo     Proxy[]  @relation("ProxyTo")
  approvals     MinutesApproval[]
}

model Board {
  id          String   @id @default(uuid())
  name        String
  description String?
  // Tenant seam: when this app runs as a module inside a MasonsView/HotelView
  // vertical, orgKey holds the host organisation/hotel identifier so boards can
  // be scoped per tenant. Null when running standalone.
  orgKey      String?
  createdAt   DateTime @default(now())

  // SharePoint destination for this board's packs. Files live there, not here.
  sharepointSiteId     String?
  sharepointDriveId    String?
  sharepointFolderId   String?
  sharepointFolderName String?
  sharepointWebUrl     String?

  meetings    Meeting[]
  members     BoardMember[]

  @@index([orgKey])
}

model BoardMember {
  id       String @id @default(uuid())
  boardId  String
  userId   String
  role     String @default("DIRECTOR")
  board    Board  @relation(fields: [boardId], references: [id])
}

model Meeting {
  id          String   @id @default(uuid())
  boardId     String
  title       String
  date        DateTime
  location    String?
  status      String   @default("SCHEDULED")
  videoUrl    String?
  createdAt   DateTime @default(now())
  
  board       Board        @relation(fields: [boardId], references: [id])
  agendaItems AgendaItem[]
  invitations Invitation[]
  attendances Attendance[]
  motions     Motion[]
  minutes     Minutes?
  auditLogs   AuditLog[]
}

model AgendaItem {
  id          String   @id @default(uuid())
  meetingId   String
  number      String
  title       String
  presenter   String?
  duration    Int?
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  
  meeting     Meeting    @relation(fields: [meetingId], references: [id])
  documents   Document[]
}

/// A board pack paper.
///
/// When source is SHAREPOINT the bytes live in SharePoint and this row holds
/// only the pointer plus the governance metadata SharePoint has no concept of
/// (which agenda item it belongs to, tags). `path` is used only by legacy
/// LOCAL documents written to disk before the SharePoint integration.
model Document {
  id           String   @id @default(uuid())
  agendaItemId String?
  meetingId    String?
  name         String
  filename     String
  mimetype     String?
  size         Int?
  path         String?
  tags         String   @default("")
  createdAt    DateTime @default(now())

  source           String    @default("LOCAL") // LOCAL | SHAREPOINT
  sharepointDriveId String?
  sharepointItemId  String?
  sharepointWebUrl  String?
  sharepointFolder  String?  // sub-folder name, usually the meeting
  etag             String?
  modifiedAt       DateTime?
  lastSyncedAt     DateTime?

  agendaItem   AgendaItem? @relation(fields: [agendaItemId], references: [id])

  @@unique([sharepointDriveId, sharepointItemId])
  @@index([meetingId])
}

model Invitation {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  role      String   @default("DIRECTOR")
  rsvp      String   @default("PENDING")
  votingRights Boolean @default(true)
  sentAt    DateTime?
  createdAt DateTime @default(now())
  
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Attendance {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  mode      String   @default("IN_PERSON")
  joinedAt  DateTime?
  leftAt    DateTime?
  present   Boolean  @default(false)
  
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Motion {
  id          String   @id @default(uuid())
  meetingId   String
  number      String
  title       String
  description String?
  moverId     String?
  seconderId  String?
  status      String   @default("PENDING")
  result      String?
  passedAt    DateTime?
  createdAt   DateTime @default(now())
  
  meeting     Meeting  @relation(fields: [meetingId], references: [id])
  votes       Vote[]
}

model Vote {
  id        String   @id @default(uuid())
  motionId  String
  userId    String
  vote      String
  proxy     Boolean  @default(false)
  createdAt DateTime @default(now())
  
  motion    Motion @relation(fields: [motionId], references: [id])
  user      User   @relation(fields: [userId], references: [id])
}

model COI {
  id          String   @id @default(uuid())
  meetingId   String
  userId      String
  motionId    String?
  type        String
  description String
  effect      String   @default("ABSTAIN")
  declaredAt  DateTime @default(now())
  
  user        User @relation(fields: [userId], references: [id])
}

model Proxy {
  id         String   @id @default(uuid())
  meetingId  String
  fromUserId String
  toUserId   String
  lodgedAt   DateTime @default(now())
  
  fromUser   User @relation("ProxyFrom", fields: [fromUserId], references: [id])
  toUser     User @relation("ProxyTo", fields: [toUserId], references: [id])
}

model Minutes {
  id          String   @id @default(uuid())
  meetingId   String   @unique
  content     String   @default("{}")
  status      String   @default("DRAFT")
  lockedAt    DateTime?
  createdAt   DateTime @default(now())
  
  meeting     Meeting  @relation(fields: [meetingId], references: [id])
  approvals   MinutesApproval[]
}

model MinutesApproval {
  id        String   @id @default(uuid())
  minutesId String
  userId    String
  approvedAt DateTime @default(now())
  
  minutes   Minutes @relation(fields: [minutesId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Integration {
  id        String   @id @default(uuid())
  provider  String   @unique
  status    String   @default("DISCONNECTED")
  config    String   @default("{}")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  meetingId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  data      String   @default("{}")
  createdAt DateTime @default(now())
  
  meeting   Meeting? @relation(fields: [meetingId], references: [id])
}
