// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  role        String   @default("DIRECTOR")
  initials    String?
  createdAt   DateTime @default(now())

  // One profile per person, shared by every board and committee they sit on.
  phone        String?
  title        String? // how they are addressed on papers, e.g. "Grand Registrar"
  organisation String? // lodge, firm or association they come from
  bio          String?

  invitations   Invitation[]
  attendances   Attendance[]
  votesAs       Vote[]
  cois          COI[]
  proxiesFrom   Proxy[]  @relation("ProxyFrom")
  proxiesTo     Proxy[]  @relation("ProxyTo")
  approvals     MinutesApproval[]
  interests     MemberInterest[]
  memberships   BoardMember[]
}

/// A board, committee or sub-committee.
///
/// Committees are boards with a parent — same fields, same meetings, same
/// register — because a committee runs on the same rules and its conflicts are
/// declared the same way. Modelling them as a separate thing would duplicate
/// all of it for no gain.
model Board {
  id          String   @id @default(uuid())
  name        String
  description String?

  /// BOARD | COMMITTEE | SUBCOMMITTEE
  kind        String   @default("BOARD")
  /// The body this one reports to, when it is a committee.
  parentId    String?
  parent      Board?   @relation("BoardHierarchy", fields: [parentId], references: [id])
  children    Board[]  @relation("BoardHierarchy")

  /// Shown against declarations, e.g. "Audit & Risk Committee".
  shortName   String?

  /// How many days before a meeting the papers are due. Reports received
  /// inside this window are stamped late; after the meeting itself, "after
  /// board date". AF&AM Inc works to 4 days.
  papersDueDays Int @default(4)

  /// Quorum rule, as boards actually write them: a minimum count, roles that
  /// MUST be among those present, and roles that attend ex officio and are
  /// not counted. AF&AM Inc: 4 members who must include the Chair and the
  /// Treasurer plus any two other directors; the Secretary is ex officio.
  quorumMinimum        Int    @default(4)
  quorumRequiredRoles  String @default("CHAIR,TREASURER")
  quorumExOfficioRoles String @default("SECRETARY")
  // Named members who MUST be present, on top of any role rule — for boards
  // whose quorum names people rather than offices. Comma-separated user ids.
  quorumMandatoryUserIds String @default("")
  // Tenant seam: when this app runs as a module inside a MasonsView/HotelView
  // vertical, orgKey holds the host organisation/hotel identifier so boards can
  // be scoped per tenant. Null when running standalone.
  orgKey      String?
  createdAt   DateTime @default(now())

  // Default source for this board's packs: SHAREPOINT | VAULT | LOCAL
  packSource           String  @default("SHAREPOINT")

  // SharePoint destination for this board's packs. Files live there, not here.
  sharepointSiteId     String?
  sharepointDriveId    String?
  sharepointFolderId   String?
  sharepointFolderName String?
  sharepointWebUrl     String?

  meetings    Meeting[]
  members     BoardMember[]
  interestDisclosures InterestDisclosure[]

  @@index([orgKey])
}

/// One tenure on one board or committee.
///
/// A person's service history is the set of these rows: ending a tenure sets
/// endedAt and how it ended rather than deleting anything, so past members
/// stay on the books — still choosable for that board, shown with their
/// status — and the history reads like a service record.
model BoardMember {
  id        String    @id @default(uuid())
  boardId   String
  userId    String
  role      String    @default("DIRECTOR")
  startedAt DateTime?
  endedAt   DateTime? // null = currently serving
  status    String    @default("ACTIVE") // ACTIVE while serving; RESIGNED / RETIRED / TERM_ENDED after
  notes     String?
  board     Board     @relation(fields: [boardId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([boardId])
}

model Meeting {
  id          String   @id @default(uuid())
  boardId     String
  title       String
  date        DateTime
  location    String?
  status      String   @default("SCHEDULED")
  videoUrl    String?
  createdAt   DateTime @default(now())

  // Where this meeting's papers live. INHERIT follows the board's default,
  // which keeps the common case (a whole board on SharePoint) zero-effort while
  // still letting one meeting differ.
  //   INHERIT | SHAREPOINT | VAULT | LOCAL
  packSource String @default("INHERIT")

  // Board pack folder in SharePoint. Optional: when unset the pack is found by
  // looking for a sub-folder named after the meeting under the board's root.
  // The drive id makes a meeting's pin self-sufficient — a pasted URL works
  // even when the board has no library linked at all.
  sharepointDriveId  String?
  sharepointFolderId String?
  sharepointWebUrl   String?

  // Folder in the host platform's file vault, when packSource is VAULT.
  vaultFolderId String?
  vaultPath     String?

  /// Whether members may assign their vote to a proxy for this meeting.
  /// Asked when the meeting is scheduled; proxies register on the meeting page.
  proxiesAllowed Boolean @default(true)

  // Per-meeting quorum overrides; null inherits the board's rule.
  quorumMinimum        Int?
  quorumRequiredRoles  String?
  quorumExOfficioRoles String?
  quorumMandatoryUserIds String?
  
  board       Board        @relation(fields: [boardId], references: [id])
  agendaItems AgendaItem[]
  invitations Invitation[]
  attendances Attendance[]
  motions     Motion[]
  minutes     Minutes?
  auditLogs   AuditLog[]
}

model AgendaItem {
  id          String   @id @default(uuid())
  meetingId   String
  /// When set, this item is derived from a pack folder and follows it: rename
  /// the folder and the item renames, delete it and the item goes. Items
  /// added by hand have no source and are never touched by the sync.
  sourceFolderId String?
  number      String
  title       String
  presenter   String?
  duration    Int?
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  
  meeting     Meeting    @relation(fields: [meetingId], references: [id])
  documents   Document[]
}

/// A board pack paper.
///
/// When source is SHAREPOINT the bytes live in SharePoint and this row holds
/// only the pointer plus the governance metadata SharePoint has no concept of
/// (which agenda item it belongs to, tags). `path` is used only by legacy
/// LOCAL documents written to disk before the SharePoint integration.
/// The arrival record for a pack file.
///
/// A paper's "received" stamp is the moment we FIRST saw it in the pack, and
/// it locks: a later edit to the file never rewrites when it arrived. Edits
/// only move lastModifiedAt, which the agenda shows as a separate "updated"
/// time — and only when the file genuinely changed.
model PackFileReceipt {
  id             String   @id @default(uuid())
  meetingId      String
  itemId         String // SharePoint item id — stable across edits and renames
  name           String
  receivedAt     DateTime // locked at first sighting
  lastModifiedAt DateTime // tracks the file's SharePoint modified time
  createdAt      DateTime @default(now())

  @@unique([meetingId, itemId])
  @@index([meetingId])
}

model Document {
  id           String   @id @default(uuid())
  agendaItemId String?
  meetingId    String?
  name         String
  filename     String
  mimetype     String?
  size         Int?
  path         String?
  tags         String   @default("")
  createdAt    DateTime @default(now())

  source           String    @default("LOCAL") // LOCAL | SHAREPOINT
  sharepointDriveId String?
  sharepointItemId  String?
  sharepointWebUrl  String?
  sharepointFolder  String?  // sub-folder name, usually the meeting
  etag             String?
  modifiedAt       DateTime?
  lastSyncedAt     DateTime?

  agendaItem   AgendaItem? @relation(fields: [agendaItemId], references: [id])

  @@unique([sharepointDriveId, sharepointItemId])
  @@index([meetingId])
}

model Invitation {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  role      String   @default("DIRECTOR")
  rsvp      String   @default("PENDING")
  votingRights Boolean @default(true)
  sentAt    DateTime?
  createdAt DateTime @default(now())
  
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Attendance {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  mode      String   @default("IN_PERSON")
  joinedAt  DateTime?
  leftAt    DateTime?
  present   Boolean  @default(false)
  
  meeting   Meeting @relation(fields: [meetingId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model Motion {
  id          String   @id @default(uuid())
  meetingId   String
  number      String
  title       String
  description String?
  moverId     String?
  seconderId  String?
  status      String   @default("PENDING")
  result      String?
  passedAt    DateTime?
  createdAt   DateTime @default(now())
  
  meeting     Meeting  @relation(fields: [meetingId], references: [id])
  votes       Vote[]
}

model Vote {
  id        String   @id @default(uuid())
  motionId  String
  userId    String
  vote      String
  proxy     Boolean  @default(false)
  createdAt DateTime @default(now())
  
  motion    Motion @relation(fields: [motionId], references: [id])
  user      User   @relation(fields: [userId], references: [id])
}

/// A standing entry in the register of interests.
///
/// Modelled on the AF&AM Inc register: one row per interest per member —
/// lodges, directorships, committee seats, employment — carried forward
/// between meetings and reviewed when it changes. This is NOT a per-meeting
/// declaration; that is the COI model below. A member typically has several of
/// these and declares against them when a relevant item arises.
model MemberInterest {
  id          String   @id @default(uuid())
  userId      String
  /// Legacy single-body column, superseded by disclosedToAll + disclosures.
  boardId     String?

  /// A standing disclosure to every board and committee. When false, the
  /// interest is disclosed only to the bodies listed in `disclosures` —
  /// because not every interest is relevant to every committee.
  disclosedToAll Boolean @default(true)
  disclosures    InterestDisclosure[]

  /// The interest itself, e.g. "Director, Freemasons Property Pty Ltd".
  interest    String
  /// MATERIAL_PERSONAL | PECUNIARY | PERCEIVED | DUTY_TO_DUTY | INDIRECT
  category    String   @default("DUTY_TO_DUTY")

  /// "Has the board been notified?" — the register's own column.
  notified    Boolean  @default(false)
  notifiedAt  DateTime?

  /// The two narrative columns the register carries.
  boardSteps    String?
  memberActions String?

  /// ACTIVE while it stands; ENDED once the member leaves the position, which
  /// keeps the history rather than deleting it.
  status      String   @default("ACTIVE")
  endedAt     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([boardId])
  @@index([status])
}

/// Which specific body an interest is disclosed to, when it is not a standing
/// disclosure to all of them.
model InterestDisclosure {
  id         String   @id @default(uuid())
  interestId String
  boardId    String
  createdAt  DateTime @default(now())

  interest   MemberInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  board      Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([interestId, boardId])
  @@index([boardId])
}

/// A declared interest, and what the meeting resolved about it.
///
/// Following ordinary Australian meeting practice (Joske's): an interest is
/// DECLARED by the member and minuted; the meeting then RESOLVES what follows.
/// Those are two separate facts, so they are two separate fields — a
/// declaration that has not yet been ruled on is a real and common state, and
/// collapsing them into one "effect" column loses the distinction.
model COI {
  id          String   @id @default(uuid())
  meetingId   String
  userId      String
  motionId    String?

  /// The agenda item the conflict attaches to, so the agenda itself shows the
  /// warning against the business it affects.
  agendaItemId String?

  /// Which board or committee the interest concerns. Null for legacy rows.
  boardId     String?

  /// Nature of the interest: MATERIAL_PERSONAL | PECUNIARY | PERCEIVED |
  /// DUTY_TO_DUTY | INDIRECT
  type        String
  description String

  /// What the meeting resolved. PENDING until it rules.
  ///   PENDING          declared, not yet ruled on
  ///   NOT_A_CONFLICT   meeting resolved no material conflict arises
  ///   REMAIN_AND_VOTE  meeting consented to the member remaining and voting
  ///   REMAIN_NO_VOTE   remains present, does not vote
  ///   WITHDRAW         withdraws for the item and does not vote
  effect      String   @default("PENDING")

  /// How the meeting dealt with it, for the minutes.
  resolution  String?
  resolvedAt  DateTime?
  /// Joske's point: if interested members withdraw, quorum may fail for that
  /// item. Recording it makes the risk visible rather than discovered later.
  quorumAffected Boolean @default(false)

  declaredAt  DateTime @default(now())

  user        User  @relation(fields: [userId], references: [id])

  @@index([meetingId])
  @@index([boardId])
}

/// A proxy lodged for a meeting.
///
/// Modelled on the FF SGM count sheets: the HOLDER is always a member, but the
/// GRANTOR may be a member (fromUserId), or an entity — a lodge, company or
/// association — recorded by name (grantorName + grantorKind). `votes` covers
/// bulk lodgements ("Bill Merrill — 26 proxies") without 26 rows.
model Proxy {
  id         String   @id @default(uuid())
  meetingId  String
  fromUserId String?
  /// Entity grantor when fromUserId is null, e.g. "Lodge Reynell 243".
  grantorName String?
  /// MEMBER | LODGE | COMPANY | ASSOCIATION | OTHER
  grantorKind String  @default("MEMBER")
  toUserId   String
  votes      Int      @default(1)
  lodgedAt   DateTime @default(now())

  fromUser   User? @relation("ProxyFrom", fields: [fromUserId], references: [id])
  toUser     User  @relation("ProxyTo", fields: [toUserId], references: [id])

  @@index([meetingId])
}

model Minutes {
  id          String   @id @default(uuid())
  meetingId   String   @unique
  content     String   @default("{}")
  status      String   @default("DRAFT")
  lockedAt    DateTime?
  createdAt   DateTime @default(now())
  
  meeting     Meeting  @relation(fields: [meetingId], references: [id])
  approvals   MinutesApproval[]
}

model MinutesApproval {
  id        String   @id @default(uuid())
  minutesId String
  userId    String
  approvedAt DateTime @default(now())
  
  minutes   Minutes @relation(fields: [minutesId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

/// A signed-in Microsoft account, used for delegated Graph access.
///
/// The app-only (client-credentials) path needs an Azure admin to grant an
/// application permission. Delegated access instead borrows a real person's
/// rights, which works with the delegated permissions an app registration
/// usually already has — so this is the path that needs no admin.
///
/// Only ever one row: the account board packs are read and written as.
model GraphAccount {
  id           String   @id @default(uuid())
  tenantId     String
  clientId     String
  account      String?  // UPN of the signed-in user, for display
  refreshToken String
  scopes       String   @default("")
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, clientId])
}

model Integration {
  id        String   @id @default(uuid())
  provider  String   @unique
  status    String   @default("DISCONNECTED")
  config    String   @default("{}")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  meetingId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  data      String   @default("{}")
  createdAt DateTime @default(now())
  
  meeting   Meeting? @relation(fields: [meetingId], references: [id])
}
