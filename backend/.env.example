# Local development (matches docker-compose.yml)
DATABASE_URL="postgresql://boardportal:boardportal@localhost:5440/board_portal_dev?schema=public"

# API port
PORT=3013

# Where uploaded board-pack documents are written
UPLOAD_DIR=./uploads

# CORS origin for the SPA. "*" is fine locally; set the real origin in production.
CORS_ORIGIN=http://localhost:3012

# Mount prefix for the API. Keep /api standalone; when embedded as a module
# inside a MasonsView/HotelView vertical this becomes e.g. /board-portal/api
API_PREFIX=/api

# Seed demo data on boot (Railway convenience). 1 = yes.
SEED_DEMO_DATA=0
