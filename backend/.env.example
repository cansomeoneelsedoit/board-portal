# Local development (matches docker-compose.yml)
DATABASE_URL="postgresql://boardportal:boardportal@localhost:5440/board_portal_dev?schema=public"

# API port
PORT=3013

# Where uploaded board-pack documents are written
UPLOAD_DIR=./uploads

# CORS origin for the SPA. "*" is fine locally; set the real origin in production.
CORS_ORIGIN=http://localhost:3012

# Mount prefix for the API. Keep /api standalone; when embedded as a module
# inside a MasonsView/HotelView vertical this becomes e.g. /board-portal/api
API_PREFIX=/api

# Seed demo data on boot (Railway convenience). 1 = yes.
SEED_DEMO_DATA=0

# --- SharePoint (board packs) -------------------------------------------
# Board Portal talks to Microsoft Graph as itself (client credentials), because
# it has no user login. The Azure app registration therefore needs the
# APPLICATION permission Sites.ReadWrite.All with admin consent granted --
# NOT the delegated Files.ReadWrite the SMSF platform uses.
#
# Azure portal > App registrations > your app:
#   Overview            -> Application (client) ID  -> MICROSOFT_CLIENT_ID
#                       -> Directory (tenant) ID    -> MICROSOFT_TENANT_ID
#   Certificates & secrets -> New client secret     -> MICROSOFT_CLIENT_SECRET
#   API permissions     -> Microsoft Graph -> Application permissions
#                       -> Sites.ReadWrite.All -> Grant admin consent
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Default site to browse when picking a destination folder. Format:
#   <tenant>.sharepoint.com:/sites/<SiteName>
SHAREPOINT_SITE_ID=
