{
  "name": "board-portal-backend",
  "version": "1.0.0",
  "description": "Board pack repository module - backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:railway": "prisma generate && prisma db push --skip-generate --accept-data-loss && node src/seed-if-enabled.js && node src/server.js",
    "dev": "nodemon src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node src/seed.js",
    "db:reset": "prisma db push --force-reset && node src/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.18",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.1",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.19.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=18"
  }
}
